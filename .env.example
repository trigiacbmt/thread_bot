# Copy thành .env.local (chạy local) hoặc khai báo trong Vercel > Settings > Environment Variables.
# File này CHỈ chứa key và kết nối. Mọi cấu hình còn lại (model AI, persona, chủ đề, từ khoá viral,
# lịch cron, múi giờ, topic tag, cách gắn link…) chỉnh trong dashboard → Cài đặt.

# ===== Threads app (developers.facebook.com > App > Use cases > Threads API) =====
THREADS_APP_ID=
THREADS_APP_SECRET=
# Phải trùng khớp "Redirect Callback URLs" trong app
THREADS_REDIRECT_URI=https://your-app.vercel.app/auth/callback
# Chuỗi tự đặt, nhập giống hệt ở phần cấu hình Webhooks của app
WEBHOOK_VERIFY_TOKEN=

# ===== Supabase (Project Settings > API) =====
SUPABASE_URL=https://xxxx.supabase.co
# Key BÍ MẬT: Project Settings → API Keys → "Secret keys" (sb_secret_…), hoặc tab Legacy → service_role.
# KHÔNG dùng key "Publishable" (sb_publishable_…) / anon — sẽ bị lỗi row-level security.
SUPABASE_SECRET_KEY=

# ===== Đăng nhập dashboard =====
# Dashboard đăng nhập bằng tài khoản Threads (nút "Đăng nhập bằng Threads").
# Username Threads được phép vào, phân cách bằng dấu phẩy (không cần @).
# Để trống = tài khoản đăng nhập ĐẦU TIÊN trở thành chủ, sau đó chỉ chủ vào được.
ALLOWED_THREADS_USERS=
# Tuỳ chọn: khoá ký cookie đăng nhập (chuỗi ngẫu nhiên dài). Trống = dùng THREADS_APP_SECRET.
# Đổi giá trị này = đăng xuất mọi thiết bị.
SESSION_SECRET=
# Tuỳ chọn: mật khẩu DỰ PHÒNG để vào dashboard khi chưa đăng nhập bằng Threads được
# (VD chạy localhost — Threads bắt buộc redirect HTTPS). Trống = tắt cách đăng nhập này.
ADMIN_KEY=

# ===== Trang công khai /privacy, /data-deletion (dùng cho Meta App Review) =====
APP_NAME=Threads Bot
CONTACT_EMAIL=

# ===== Cron =====
# Secret cho /api/cron/* (giống giá trị đặt trong supabase/cron.sql)
CRON_SECRET=

# ===== AI (Claude) =====
ANTHROPIC_API_KEY=

# ===== Apify (tuỳ chọn) — săn bài viral không cần Meta App Review =====
# apify.com → Settings → API & Integrations → Personal API token. Bật trong Cài đặt → Săn viral → Nguồn = Apify.
APIFY_TOKEN=

# ===== Shopee Affiliate Open API (tuỳ chọn) =====
# Có thì bot tự đổi link Shopee gốc → link affiliate khi thêm sản phẩm. Không có thì tự dán link affiliate.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_ENDPOINT=https://open-api.affiliate.shopee.vn/graphql

# ===== Scraper trên máy bạn (tuỳ chọn) — `npm run scraper` =====
# Đọc bài công khai từ các tài khoản nguồn, không cần quyền Meta, không tốn phí. Dùng chung SUPABASE_URL / SUPABASE_SECRET_KEY.
# Bật: Cài đặt → Săn viral → Lấy bài viral từ = "Scraper trên máy bạn".
# false = hiện cửa sổ Chrome để xem scraper làm gì (debug)
SCRAPER_HEADLESS=true
# Proxy nếu bị Threads chặn IP, VD: http://user:pass@host:port (trống = dùng mạng hiện tại)
SCRAPER_PROXY=

# ===== Chỉ khi self-host bằng `next start` (VPS/Railway/Render) =====
# true = chạy job nền ngay trong tiến trình, không cần supabase/cron.sql
IN_PROCESS_JOBS=false
